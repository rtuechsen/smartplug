[Unit]
Description=Smartplug Dirigent webserver service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/smartplug-dirigent/backend/
Environment="DJANGO_PIPELINE=production"
ExecStart=/opt/smartplug-dirigent/backend/django-env/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    smartplug_app.asgi:application \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 1 \
    --graceful-timeout 0

User=www-data
Group=www-data

Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
