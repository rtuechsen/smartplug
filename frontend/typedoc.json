{
	"$schema": "https://typedoc.org/schema.json",
	"name": "Smartplug Dirigent - Frontend",
	"entryPoints": [
		"./src/*.tsx"
	],
	"out": "./docs",
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"rewrittenLink": true,
		"notDocumented": true,
		"unusedMergeModuleWith": true
	},
	"projectDocuments": [
		"./high level documentation.md"
	]
}