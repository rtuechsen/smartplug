{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Frontend Debug (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/frontend/src",
			"trace": true,
			"sourceMaps": true,
			"perScriptSourcemaps": "yes"
		},
		{
			"name": "Backend Debug (Django ASGI Uvicorn)",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": [
				"smartplug_app.asgi:application",
			],
			"django": true,
			"subProcess": true,
			"justMyCode": true,
			"env": {
				"DJANGO_SETTINGS_MODULE": "smartplug_app.settings.settings_development"
			},
			"cwd": "${workspaceFolder}/backend",
		}
	]
}